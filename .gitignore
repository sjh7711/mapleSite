# Dependencies and build output
**/node_modules/
**/dist/
**/.wrangler/
**/.artifacts/
**/.venv/
**/__pycache__/
**/*.pyc

# Secrets and machine-local state
**/.env
**/.env.*
**/*credentials*
**/*secret*
**/youtube-cookies.txt

# Temporary browser and audit output
**/.tmp*
**/profile-*/

# Large data is archived outside normal Git history
maplestarforce/item_price_raw/
maplestarforce/public/item-market/releases/*
!maplestarforce/public/item-market/releases/22762152e065ef31aa1f/
!maplestarforce/public/item-market/releases/22762152e065ef31aa1f/**
maplestarforce/tools/item-market-dataset/market-data/
!maplestarforce/tools/item-market-dataset/market-data/
maplestarforce/tools/item-market-dataset/market-data/*
!maplestarforce/tools/item-market-dataset/market-data/review.csv
maplestarforce/tools/battle-practice-dataset/raw/
maplestarforce/tools/battle-practice-dataset/generated/

# OS/editor files
.DS_Store
Thumbs.db
*.swp

# Only blank/sanitized configuration examples may be committed.
!**/.env.example
!**/.env.*.example

/services/blacksmith-inbox/.build/

# Databases, host-only config, and runtime state
**/.dev.vars
**/.dev.vars.*
!**/.dev.vars.example
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
**/*.key
**/*.pem
**/*.log
**/vm-upload-config.json
