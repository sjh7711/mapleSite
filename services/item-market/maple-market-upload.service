[Unit]
Description=Maple market capture receiver and Cloudflare tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/mapleSite/maplestarforce
Environment=MAPLE_UPLOAD_CONFIG=/home/ubuntu/.config/maple-market-upload/config.json
ExecStart=/home/ubuntu/.nvm/versions/node/v22.23.4/bin/node /home/ubuntu/mapleSite/services/item-market/upload.mjs
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
