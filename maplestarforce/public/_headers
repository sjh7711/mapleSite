# Cloudflare Pages 전용 캐시 규칙. nginx에 걸어 둔 것과 같은 정책을 옮겼다.

# 검색엔진과 검증기가 사이트맵을 HTML로 오인하지 않도록 MIME을 고정한다.
/sitemap.xml
  Content-Type: application/xml
  X-Content-Type-Options: nosniff

# 파일 이름에 해시가 붙어 있어 내용이 바뀌면 이름도 바뀐다. 영구 캐시해도 안전하다.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 확률표 포인터만 매번 갱신 여부를 확인하고, 버전이 붙은 실제 데이터는 장기 보관한다.
/potential-tables/manifest.json
  Cache-Control: no-cache

/potential-tables/index.json
  Cache-Control: public, max-age=31536000, immutable

/potential-tables/regular-*
  Cache-Control: public, max-age=31536000, immutable

/potential-tables/additional-*
  Cache-Control: public, max-age=31536000, immutable

# 아이콘은 이름이 고정이라 30일만 잡는다.
/equipments/*
  Cache-Control: public, max-age=2592000

# 활성 포인터는 배포 직후 새 버전을 다시 확인한다.
/item-market/manifest.json
  Cache-Control: no-cache

# 데이터 버전 경로는 내용이 바뀌면 경로도 바뀌므로 영구 캐시한다.
/item-market/releases/*
  Cache-Control: public, max-age=31536000, immutable
