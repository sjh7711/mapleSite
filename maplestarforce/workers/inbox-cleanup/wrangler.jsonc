{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "starforce-inbox-preview-cleanup",
  "main": "index.ts",
  "compatibility_date": "2026-11-02",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "ratelimits": [
    { "name": "READ_CLIENT", "namespace_id": "760031", "simple": { "limit": 60, "period": 60 } },
    { "name": "WRITE_CLIENT", "namespace_id": "760032", "simple": { "limit": 20, "period": 60 } },
    { "name": "READ_IP", "namespace_id": "760033", "simple": { "limit": 300, "period": 60 } },
    { "name": "WRITE_IP", "namespace_id": "760034", "simple": { "limit": 120, "period": 60 } }
  ],
  "d1_databases": [{
    "binding": "STARFORCE_INBOX_DB",
    "database_name": "starforce-inbox-preview",
    "database_id": "60641ab2-08b9-41a0-a268-5faffd744edf"
  }]
}
