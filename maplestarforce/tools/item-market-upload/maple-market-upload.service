[Unit]
Description=Maple market capture receiver and Cloudflare tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/maplestarforce
Environment=MAPLE_UPLOAD_CONFIG=/home/ubuntu/.config/maple-market-upload/config.json
ExecStart=/home/ubuntu/.nvm/versions/node/v22.12.0/bin/node /home/ubuntu/maplestarforce/tools/item-market-upload/service.mjs
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
