[Unit]
Description=Private backup of Starforce preview inbox SQLite
After=starforce-inbox-preview.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/maple-platform/mapleSite/maplestarforce
Environment=INBOX_API_CONFIG=/home/ubuntu/.config/starforce-inbox-preview/config.json
ExecStart=/home/ubuntu/.nvm/versions/node/v22.23.4/bin/node tools/inbox-api/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.local/share/starforce-inbox-preview
